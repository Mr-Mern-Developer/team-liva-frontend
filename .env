# Committed defaults so a fresh clone runs against the deployed API with no setup.
# These are NEXT_PUBLIC_*, so Next.js inlines them into the browser bundle — public
# by design, never put a secret here. Override locally in .env.local (gitignored).

NEXT_PUBLIC_API_URL=https://teamliva-backend.vercel.app/api

# Update this once the site has a real domain — it drives metadataBase,
# canonical URLs, sitemap and OpenGraph tags.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
