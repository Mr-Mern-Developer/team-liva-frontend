# Committed defaults so a fresh clone runs against the deployed API with no setup.
# These are NEXT_PUBLIC_*, so Next.js inlines them into the browser bundle — public
# by design, never put a secret here.
#
# Note: .env.local is currently committed too, and Next.js lets it override this
# file — so change both, or neither takes effect the way you expect.

NEXT_PUBLIC_API_URL=https://teamliva-backend.vercel.app/api

# Drives metadataBase, canonical URLs, sitemap and OpenGraph tags.
NEXT_PUBLIC_SITE_URL=https://teamliva.com
